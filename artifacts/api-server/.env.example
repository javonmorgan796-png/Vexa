# Copy this file to .env for local development only.
# Never commit .env or place service-role/private keys in frontend code.

# Optional: comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173

# Keep private provider credentials server-side.
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# COINGECKO_API_KEY=