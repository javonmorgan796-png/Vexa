# Copy this file to .env for local development only.
# Never commit .env or place service-role/private keys in frontend code.

# Optional: comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173

# Keep private provider credentials server-side.
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# TATUM_API_KEY=
# TATUM_WEBHOOK_SECRET=
# Optional override; defaults to the production Vexa webhook URL.
# The configured endpoint is https://vexa-superbase-connect-1--myp847842.replit.app/api/crypto/webhooks/tatum
# TATUM_WEBHOOK_URL=
# COINGECKO_API_KEY=
# Paystack secret key. Use a secret key beginning with sk_test_ or sk_live_.
# Store the real value in Replit Secrets, never in frontend code.
# PAYSTACK_SECRET_KEY=
# LOGO_DEV_TOKEN=
# TERMII_API_KEY=
# Optional approved Termii sender ID; defaults to N-Alert.
# TERMII_SENDER_ID=